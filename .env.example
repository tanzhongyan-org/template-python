APP_NAME=template-python
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/template_python
TRUST_IDENTITY_HEADER=true
MAX_REQUEST_BODY_BYTES=1048576
# Host port for the local Postgres container; change it if 5432 is taken.
POSTGRES_PORT=5432

# Product JWT validation (Better Auth jwt plugin). Unset means bearer tokens are rejected.
#JWKS_URL=https://auth.example.com/api/auth/jwks
#JWT_ISSUER=https://auth.example.com
#JWT_AUDIENCE=https://api.example.com
